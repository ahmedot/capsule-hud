<Window x:Class="Capsule.UI.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{x:Null}"
        Title="Install Capsule"
        Width="600"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI">

  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="Surface" Color="#FF121318" />
    <SolidColorBrush x:Key="Text" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Subtext" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="Faint" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="Hairline" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Mint" Color="#FF3DDC97" />
    <SolidColorBrush x:Key="MintSoft" Color="#263DDC97" />
    <SolidColorBrush x:Key="Bad" Color="#FFFF8A94" />
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF4BE3A2" Offset="0" />
      <GradientStop Color="#FF2EC4B6" Offset="1" />
    </LinearGradientBrush>

    <!-- Big pill-shaped call to action -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="50" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#FF06140D" />
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Glow" CornerRadius="25" Background="{DynamicResource BrandGradient}" Opacity="0.0">
                <Border.Effect>
                  <BlurEffect Radius="22" />
                </Border.Effect>
              </Border>
              <Border x:Name="Face" CornerRadius="25" Background="{DynamicResource BrandGradient}">
                <Grid>
                  <Border x:Name="Shine" CornerRadius="25" Opacity="0">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#40FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border x:Name="FocusRing" CornerRadius="28" Margin="-4" BorderThickness="2" BorderBrush="#CCFFFFFF"
                      Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shine" Property="Opacity" Value="1" />
                <Setter TargetName="Glow" Property="Opacity" Value="0.55" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Glow" Property="Opacity" Value="0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Quiet text button -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="Transparent" Padding="10,5" CornerRadius="6" BorderThickness="1"
                    BorderBrush="Transparent">
              <ContentPresenter x:Name="Text" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#99FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Window caption buttons -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Foreground" Value="#CCFFFFFF" />
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#1FFFFFFF" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#99FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On/off switch in the brand colour -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="44" Height="24" Background="Transparent">
              <Border x:Name="Track" CornerRadius="12" Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" />
              <Border x:Name="FocusRing" CornerRadius="15" Margin="-3" BorderThickness="2" BorderBrush="#CCFFFFFF"
                      Visibility="Collapsed" />
              <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="5,0,0,0" Fill="#CCFFFFFF">
                <Ellipse.RenderTransform>
                  <TranslateTransform x:Name="KnobMove" X="0" />
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrandGradient}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                <Setter TargetName="Knob" Property="Fill" Value="#FF06140D" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FeatureTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="FeatureText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Subtext}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
  </Window.Resources>

  <!-- The outer margin leaves room for the shadow. -->
  <Grid Margin="26">
    <Border CornerRadius="18" Background="{StaticResource Surface}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="44" ShadowDepth="12" Direction="270" Opacity="0.55" Color="#000000" />
      </Border.Effect>
    </Border>

    <Grid x:Name="Frame">
      <Grid.RowDefinitions>
        <RowDefinition Height="240" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============================================================ hero -->
      <Grid x:Name="Hero" Grid.Row="0" ClipToBounds="True" MouseLeftButtonDown="OnDrag" Background="#FF0B0C10">
        <Ellipse x:Name="GlowA" Width="460" Height="330" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-150,0,0">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#803DDC97" Offset="0" />
              <GradientStop Color="#003DDC97" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform>
            <TranslateTransform x:Name="GlowMint" />
          </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="GlowB" Width="520" Height="360" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-190,-170">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#808B7CFF" Offset="0" />
              <GradientStop Color="#008B7CFF" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform>
            <TranslateTransform x:Name="GlowViolet" />
          </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="GlowC" Width="300" Height="200" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="120,-120,0,0">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#552EC4B6" Offset="0" />
              <GradientStop Color="#002EC4B6" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform>
            <TranslateTransform x:Name="GlowTeal" />
          </Ellipse.RenderTransform>
        </Ellipse>

        <!-- soft fade into the body -->
        <Rectangle Height="90" VerticalAlignment="Bottom">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00121318" Offset="0" />
              <GradientStop Color="#FF121318" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>

        <!-- live demo of the HUD -->
        <Grid x:Name="DemoHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0"
              Opacity="0" IsHitTestVisible="False">
          <Border x:Name="DemoPill" Height="48" Width="48" HorizontalAlignment="Center" CornerRadius="24"
                  Background="#F0141519" BorderBrush="#26FFFFFF" BorderThickness="1">
            <Border.Effect>
              <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <Grid ClipToBounds="True">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="7,0,0,0" VerticalAlignment="Center">
                <Grid Width="32" Height="32" RenderTransformOrigin="0.5,0.5">
                  <Grid.RenderTransform>
                    <ScaleTransform x:Name="DemoIconScale" ScaleX="1" ScaleY="1" />
                  </Grid.RenderTransform>
                  <Ellipse Fill="{DynamicResource MintSoft}" />
                  <TextBlock x:Name="DemoGlyph" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="DemoDetails" Orientation="Horizontal" Margin="11,0,0,0" VerticalAlignment="Center"
                            Opacity="0">
                  <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="DemoDetailsShift" />
                  </StackPanel.RenderTransform>
                  <TextBlock x:Name="DemoTitle" FontSize="14.5" FontWeight="SemiBold" Foreground="White"
                             VerticalAlignment="Center" />
                  <StackPanel x:Name="DemoStatusPanel" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,1,7,0" Fill="{DynamicResource Mint}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DemoStatus" FontSize="13.5" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                  </StackPanel>
                  <Grid x:Name="DemoLevelPanel" Width="120" Height="5" Margin="14,1,0,0" VerticalAlignment="Center">
                    <Border CornerRadius="2.5" Background="#29FFFFFF" />
                    <Border CornerRadius="2.5" Background="{DynamicResource Mint}" RenderTransformOrigin="0,0.5">
                      <Border.RenderTransform>
                        <ScaleTransform x:Name="DemoLevel" ScaleX="0.6" />
                      </Border.RenderTransform>
                    </Border>
                  </Grid>
                  <Border x:Name="DemoChip" Margin="12,0,0,0" Padding="8,3,9,3" CornerRadius="10" Background="#17FFFFFF"
                          VerticalAlignment="Center">
                    <TextBlock x:Name="DemoChipText" FontSize="12.5" Foreground="#B3FFFFFF" />
                  </Border>
                  <Border Width="20" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <!-- caption buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
          <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize"
                  AutomationProperties.Name="Minimize" ToolTip="Minimize" />
          <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="OnClose"
                  IsCancel="True" AutomationProperties.Name="Close" ToolTip="Close" />
        </StackPanel>
      </Grid>

      <!-- ============================================================ body -->
      <Grid Grid.Row="1" Margin="40,0,40,30">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- name -->
        <Grid Grid.Row="0" Margin="0,-6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image Source="/Assets/Capsule.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"
                 VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Capsule" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                       Foreground="{StaticResource Text}" />
            <TextBlock Text="Your devices, at a glance." FontSize="14.5" Foreground="{StaticResource Subtext}"
                       Margin="0,1,0,0" />
          </StackPanel>
          <Border Grid.Column="2" VerticalAlignment="Center" Padding="10,4" CornerRadius="11" Background="#14FFFFFF"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1">
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource Subtext}" />
          </Border>
        </Grid>

        <!-- ready / installing / error -->
        <StackPanel x:Name="SetupPanel" Grid.Row="1" Margin="0,26,0,0">
          <StackPanel.RenderTransform>
            <TranslateTransform x:Name="SetupShift" />
          </StackPanel.RenderTransform>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40" VerticalAlignment="Top">
              <Ellipse Fill="{DynamicResource MintSoft}" />
              <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="14,1,0,0">
              <TextBlock Style="{StaticResource FeatureTitle}" Text="A clean pop-up for everything" />
              <TextBlock Style="{StaticResource FeatureText}"
                         Text="Headphones, controllers, volume and music in one tidy pill." />
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40" VerticalAlignment="Top">
              <Ellipse Fill="{DynamicResource MintSoft}" />
              <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="14,1,0,0">
              <TextBlock Style="{StaticResource FeatureTitle}" Text="Sound goes where you want it" />
              <TextBlock Style="{StaticResource FeatureText}"
                         Text="Connect your headphones and the sound follows them." />
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40" VerticalAlignment="Top">
              <Ellipse Fill="{DynamicResource MintSoft}" />
              <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="14,1,0,0">
              <TextBlock Style="{StaticResource FeatureTitle}" Text="Light, private and free" />
              <TextBlock Style="{StaticResource FeatureText}"
                         Text="Barely uses your PC, needs no account and never tracks you." />
            </StackPanel>
          </Grid>

          <!-- start with Windows -->
          <Border CornerRadius="12" Background="#0DFFFFFF" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                  Padding="16,12" Margin="0,0,0,22">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Start with Windows" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                <TextBlock Text="Recommended, so Capsule is always ready" FontSize="12.5" Foreground="{StaticResource Faint}"
                           Margin="0,1,0,0" />
              </StackPanel>
              <CheckBox x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True"
                        VerticalAlignment="Center" AutomationProperties.Name="Start with Windows" />
            </Grid>
          </Border>

          <!-- install button, with a progress sweep while working -->
          <Grid>
            <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnInstall"
                    AutomationProperties.Name="Install Capsule">
              <TextBlock x:Name="InstallText" Text="Install" />
            </Button>
            <Border x:Name="Sweep" CornerRadius="25" IsHitTestVisible="False" Opacity="0" ClipToBounds="True">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <LinearGradientBrush.RelativeTransform>
                    <TranslateTransform x:Name="SweepMove" X="-0.3" />
                  </LinearGradientBrush.RelativeTransform>
                  <GradientStop Color="#00FFFFFF" Offset="0.0" />
                  <GradientStop Color="#55FFFFFF" Offset="0.12" />
                  <GradientStop Color="#00FFFFFF" Offset="0.24" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Grid>

          <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource Bad}" FontSize="13"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />

          <TextBlock x:Name="FinePrint" Text="Just for you · No admin rights needed · Remove it anytime in Settings › Apps"
                     FontSize="12" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,14,0,0" />
          <Button x:Name="PortableButton" Style="{StaticResource LinkButton}" Content="Try it without installing"
                  HorizontalAlignment="Center" Margin="0,4,0,0" Click="OnRunPortable" />
        </StackPanel>

        <!-- done -->
        <StackPanel x:Name="DonePanel" Grid.Row="1" Margin="0,30,0,0" Visibility="Collapsed" Opacity="0">
          <StackPanel.RenderTransform>
            <TranslateTransform x:Name="DoneShift" Y="12" />
          </StackPanel.RenderTransform>
          <Grid Width="76" Height="76" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="CheckScale" ScaleX="0.6" ScaleY="0.6" />
            </Grid.RenderTransform>
            <Ellipse Fill="{DynamicResource BrandGradient}">
              <Ellipse.Effect>
                <DropShadowEffect x:Name="CheckGlow" BlurRadius="30" ShadowDepth="0" Opacity="0.55" Color="#3DDC97" />
              </Ellipse.Effect>
            </Ellipse>
            <Path x:Name="CheckMark" Data="M 24,39 L 34,49 L 53,28" Stroke="#FF06140D" StrokeThickness="5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  StrokeDashArray="12 12" StrokeDashOffset="12" />
          </Grid>
          <TextBlock Text="You're all set" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                     Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,22,0,0" />
          <TextBlock x:Name="DoneText" FontSize="14" Foreground="{StaticResource Subtext}" TextWrapping="Wrap"
                     TextAlignment="Center" Margin="10,8,10,0" LineHeight="21"
                     Text="Capsule is running. It pops up on its own when you connect headphones, change the volume and more." />

          <Border CornerRadius="12" Background="#0DFFFFFF" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                  Padding="16,12" Margin="0,22,0,22">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource Mint}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Margin="14,0,0,0" FontSize="13" Foreground="{StaticResource Subtext}"
                         TextWrapping="Wrap" VerticalAlignment="Center"
                         Text="To change anything later, open Capsule from the Start menu, or click its icon near the clock." />
            </Grid>
          </Border>

          <Border x:Name="KeyboardAppCard" Visibility="Collapsed" CornerRadius="12" Background="#0DFFFFFF"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="16,12" Margin="0,-10,0,22">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource Mint}"
                         VerticalAlignment="Top" Margin="0,2,0,0" />
              <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock x:Name="KeyboardAppText" FontSize="13" Foreground="{StaticResource Subtext}" TextWrapping="Wrap" />
                <Button x:Name="KeyboardAppButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                        Margin="-10,4,0,-4" Click="OnOpenKeyboardApp" Foreground="{DynamicResource Mint}" />
              </StackPanel>
            </Grid>
          </Border>

          <Button x:Name="DoneButton" Style="{StaticResource PrimaryButton}" Click="OnDone"
                  AutomationProperties.Name="Done">
            <TextBlock Text="Done" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
