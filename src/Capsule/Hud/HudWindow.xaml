<Window x:Class="Capsule.Hud.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{x:Null}"
        Title="Capsule HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxHeight="260"
        UseLayoutRounding="True">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="HudBackground" Color="#F0141519" />
    <SolidColorBrush x:Key="HudBorder" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="HudText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="HudSubtext" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="HudTrack" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="HudChip" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="HudAccent" Color="#FF34D17A" />
    <SolidColorBrush x:Key="HudAccentSoft" Color="#2934D17A" />
    <SolidColorBrush x:Key="HudBad" Color="#FFF0616D" />
    <SolidColorBrush x:Key="HudBadSoft" Color="#59F0616D" />
  </Window.Resources>

  <!-- The outer margin leaves room for the shadow. -->
  <Grid x:Name="Root" Margin="28">
    <Grid.LayoutTransform>
      <ScaleTransform x:Name="SizeScale" ScaleX="1" ScaleY="1" />
    </Grid.LayoutTransform>

    <!-- Stage has the size of the fully open pill; the pill grows inside it from the middle. -->
    <Grid x:Name="Stage" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1" />
      </Grid.RenderTransform>

      <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Stretch"
              Background="{DynamicResource HudBackground}"
              BorderBrush="{DynamicResource HudBorder}" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.38" Color="#000000" />
        </Border.Effect>
      </Border>

      <Grid x:Name="ContentHost" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="ContentShift" X="0" />
        </Grid.RenderTransform>
        <StackPanel x:Name="PillContent" Orientation="Horizontal" Margin="8,7,20,7" VerticalAlignment="Center">

          <!-- icon bubble: the only thing visible while the pill is closed -->
          <Grid Width="32" Height="32" VerticalAlignment="Center">
            <Ellipse x:Name="IconBubble" Fill="{DynamicResource HudAccentSoft}" />
            <TextBlock x:Name="IconText" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                       Foreground="{DynamicResource HudAccent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse Visibility="{Binding HasArt, Converter={StaticResource Visible}}"
                     Stroke="{DynamicResource HudBorder}" StrokeThickness="1">
              <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
              </Ellipse.Fill>
            </Ellipse>
          </Grid>

          <StackPanel x:Name="Details" Orientation="Horizontal" Margin="11,0,0,0" VerticalAlignment="Center">
            <StackPanel.RenderTransform>
              <TranslateTransform x:Name="DetailsShift" X="0" />
            </StackPanel.RenderTransform>
            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource TextFont}" FontSize="14.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource HudText}" VerticalAlignment="Center"
                       MaxWidth="280" TextTrimming="CharacterEllipsis" />

            <!-- status: dot + text -->
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
              <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,1,7,0" VerticalAlignment="Center"
                       Fill="{DynamicResource HudAccent}" />
              <TextBlock Text="{Binding Status}" FontFamily="{StaticResource TextFont}" FontSize="13.5"
                         Foreground="{DynamicResource HudSubtext}" VerticalAlignment="Center"
                         MaxWidth="240" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- level bar (volume, brightness) -->
            <Grid Width="128" Height="5" Margin="14,1,0,0" VerticalAlignment="Center"
                  Visibility="{Binding HasLevel, Converter={StaticResource Visible}}">
              <Border CornerRadius="2.5" Background="{DynamicResource HudTrack}" />
              <Border CornerRadius="2.5" Background="{DynamicResource HudAccent}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                  <ScaleTransform ScaleX="{Binding LevelScale}" ScaleY="1" />
                </Border.RenderTransform>
              </Border>
            </Grid>
            <!-- Fixed width (fits "100%" and "Muted") so the pill keeps one size while the level changes. -->
            <TextBlock Text="{Binding LevelText}" FontFamily="{StaticResource TextFont}" FontSize="13.5" Width="44"
                       Typography.NumeralAlignment="Tabular"
                       TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource HudSubtext}"
                       Visibility="{Binding HasLevel, Converter={StaticResource Visible}}" />

            <!-- battery chip -->
            <Border Margin="12,0,0,0" Padding="8,3,9,3" CornerRadius="10" VerticalAlignment="Center"
                    Background="{DynamicResource HudChip}"
                    Visibility="{Binding HasBattery, Converter={StaticResource Visible}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding BatteryGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{DynamicResource HudSubtext}" Margin="0,1,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BatteryText}" FontFamily="{StaticResource TextFont}" FontSize="12.5"
                           Foreground="{DynamicResource HudSubtext}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
